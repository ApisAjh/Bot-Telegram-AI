# Token bot dari @BotFather di Telegram
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# URL publik tempat bot di-deploy, diakhiri dengan /api/webhook
WEBHOOK_URL=https://nama-project-anda.vercel.app/api/webhook

# API Key dari console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opsional) Model Groq yang dipakai
GROQ_MODEL=llama-3.3-70b-versatile

# (Opsional) Secret token tambahan untuk validasi webhook Telegram
WEBHOOK_SECRET=
